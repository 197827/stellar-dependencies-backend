HOST=127.0.0.1
PORT=3000
# Optional: server-side token with public repository read access only.
#
# Rate limits: unauthenticated GitHub API requests are rate-limited quickly
# (typically 60 requests/hour per IP). When the limit is hit, the API responds
# with an actionable error that includes the reset time and reminds you to set
# GITHUB_TOKEN. Automatic retries are not performed, so you won't trigger
# retry storms.
#
# Recommended: set GITHUB_TOKEN to raise the rate limit. Use a token with
# public repository read access only (no write scopes).
GITHUB_TOKEN=